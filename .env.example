# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_BASE_URL=http://api:8000
WEB_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://spy:spy@postgres:5432/spy
DATABASE_URL_SYNC=postgresql+psycopg://spy:spy@postgres:5432/spy
POSTGRES_USER=spy
POSTGRES_PASSWORD=spy
POSTGRES_DB=spy
# Per-process connection pool (api, worker, and beat each hold their own).
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) * number of processes sharing this
# Postgres must stay under Postgres's own max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ── Redis / Queue ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security (§104) ──────────────────────────────────────────────────
# Only set to true when this process sits behind a reverse proxy/load
# balancer that sets X-Forwarded-For itself and strips any client-supplied
# copy first — otherwise a caller can spoof it to dodge rate limits.
TRUST_PROXY_HEADERS=false

# ── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-32-bytes-minimum-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# ── Google OAuth (login + GSC) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GSC_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gsc/callback

# ── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Object storage (MinIO / S3-compatible) ──────────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=spyminio
STORAGE_SECRET_KEY=spyminio123
STORAGE_BUCKET=spy-reports
STORAGE_REGION=us-east-1

# ── Encryption ───────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-key==

# ── Crawler ──────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=SpyBot/1.0 (+http://localhost:3000/spybot)
CRAWLER_MAX_CONCURRENCY_PER_HOST=4
CRAWLER_GLOBAL_CONCURRENCY=20
JS_RENDER_ENABLED=false

# ── Feature flags (seeded into DB; these are dev bootstrap defaults) ─
GSC_ENABLED=false
BACKLINKS_ENABLED=false
COMMON_CRAWL_ENABLED=false
AEO_ENABLED=true
GEO_ENABLED=true
RANK_TRACKING_ENABLED=false

# ── Email (dev: Mailhog/console) ─────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@spy.local

# ── Next.js (apps/web) ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-32-bytes-minimum-random-value
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/proxy
