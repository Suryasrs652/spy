# Production env for the single-VPS stack (docker-compose.prod.yml).
# Copy to `.env.production` ON THE SERVER and fill in real values — that
# file is gitignored and must never be committed (§150).
#
# Generate the three guarded secrets (app/core/config.py refuses to boot
# with ENVIRONMENT=production if any still holds its shipped placeholder):
#   openssl rand -base64 32                                   # AUTH_SECRET
#   openssl rand -base64 32                      # INTERNAL_SERVICE_TOKEN
#   openssl rand -base64 32                            # NEXTAUTH_SECRET
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#                                                    # TOKEN_ENCRYPTION_KEY

# ── Hostnames (Caddy issues a Let's Encrypt cert per name) ───────────────
# Each must already resolve to this server's public IP before first boot.
API_HOSTNAME=api.example.com
STORAGE_HOSTNAME=storage.example.com
# Only set when running the `fullstack` profile (Next.js on this box too).
# Leave unset while the frontend is deployed on Vercel.
WEB_HOSTNAME=

# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Where the browser reaches the frontend — used for verification/reset
# links and the GSC OAuth return redirect.
WEB_BASE_URL=https://your-frontend.vercel.app
API_BASE_URL=https://api.example.com

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=spy
POSTGRES_PASSWORD=
POSTGRES_DB=spy
DATABASE_URL=postgresql+asyncpg://spy:${POSTGRES_PASSWORD}@postgres:5432/spy
DATABASE_URL_SYNC=postgresql+psycopg://spy:${POSTGRES_PASSWORD}@postgres:5432/spy
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) × (api + worker + beat replicas) must
# stay under Postgres's max_connections — see loadtest/README.md finding #2.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# ── Redis / Queue ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security (§104) ──────────────────────────────────────────────────
# Safe to enable here: infra/caddy/Caddyfile overwrites X-Forwarded-For
# with the real peer address, so a client can't spoof it.
TRUST_PROXY_HEADERS=true
AUTH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INTERNAL_SERVICE_TOKEN=

# ── Google OAuth (login + GSC) ───────────────────────────────────────
# Add https://api.example.com/api/v1/integrations/gsc/callback to the
# authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GSC_REDIRECT_URI=https://api.example.com/api/v1/integrations/gsc/callback

# ── Razorpay ─────────────────────────────────────────────────────────
# Point the webhook at https://api.example.com/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Object storage (MinIO on this box) ───────────────────────────────
# Uploads go over the compose network; presigned download URLs are signed
# for the public name, so STORAGE_PUBLIC_ENDPOINT must match
# STORAGE_HOSTNAME (and MINIO_SERVER_URL, which compose sets from it).
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=spy-reports
STORAGE_REGION=us-east-1

# ── Encryption ───────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=

# ── Crawler ──────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=SpyBot/1.0 (+https://your-frontend.vercel.app/spybot)
CRAWLER_MAX_CONCURRENCY_PER_HOST=4
CRAWLER_GLOBAL_CONCURRENCY=20
JS_RENDER_ENABLED=false

# ── Feature flags (DB-seeded; these are bootstrap defaults) ──────────
GSC_ENABLED=false
BACKLINKS_ENABLED=false
COMMON_CRAWL_ENABLED=false
AEO_ENABLED=true
GEO_ENABLED=true
RANK_TRACKING_ENABLED=false

# ── Email ────────────────────────────────────────────────────────────
# A real relay (Postmark/Resend/SES/...). Without one, signup still
# succeeds but verification mail is only logged (app/core/email.py
# swallows send failures so they can't fail the request).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@example.com

# ── Next.js (only needed with the `fullstack` profile) ───────────────
NEXTAUTH_URL=https://your-frontend.vercel.app
NEXTAUTH_SECRET=
