<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Spy Audit Report — {{ project.name }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; margin: 0; color: #16181d; background: #fff; }
  .page { padding: 48px 56px; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 32px 0 12px; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px; }
  .muted { color: #6b7280; font-size: 13px; }
  .score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 20px; }
  .score-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 16px; text-align: center; }
  .score-card .value { font-size: 30px; font-weight: 700; }
  .score-card .label { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; margin-top: 4px; }
  .band-excellent { color: #0a7d3c; } .band-good { color: #2563eb; }
  .band-needs { color: #b45309; } .band-poor { color: #c2410c; } .band-critical { color: #b91c1c; }
  table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #eef0f3; vertical-align: top; }
  th { background: #f8f9fb; font-size: 11px; text-transform: uppercase; color: #6b7280; }
  .sev { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; color: #fff; }
  .sev-CRITICAL { background: #b91c1c; } .sev-HIGH { background: #c2410c; }
  .sev-MEDIUM { background: #b45309; } .sev-LOW { background: #2563eb; } .sev-INFO { background: #6b7280; }
  .footer { margin-top: 48px; font-size: 11px; color: #9ca3af; }
</style>
</head>
<body>
<div class="page">
  <h1>Spy Audit Report</h1>
  <div class="muted">{{ project.domain }} &middot; Generated {{ generated_at }} &middot; Score methodology {{ audit.score_version }}</div>

  <h2>Overall Digital Search Score</h2>
  <div class="score-grid">
    <div class="score-card"><div class="value {{ band_class }}">{{ audit.spy_score }}</div><div class="label">Overall</div></div>
    <div class="score-card"><div class="value">{{ audit.seo_score if audit.seo_score is not none else "N/A" }}</div><div class="label">SEO</div></div>
    <div class="score-card"><div class="value">{{ audit.aeo_score if audit.aeo_score is not none else "N/A" }}</div><div class="label">AEO</div></div>
    <div class="score-card"><div class="value">{{ audit.geo_score if audit.geo_score is not none else "N/A" }}</div><div class="label">GEO</div></div>
  </div>
  <p class="muted">
    SEO is whether a search engine can crawl, index and rank the site; AEO whether an answer
    engine can lift an answer out of it; GEO whether a generative system can tell who wrote it
    and reuse it. Confidence: {{ audit.confidence }}% (based on {{ evidence.urls_processed }} pages crawled).
  </p>

  <h2>What&rsquo;s wrong</h2>
  <div class="score-grid">
    <div class="score-card"><div class="value">{{ issue_counts.critical.issues }}</div><div class="label">Critical issues</div></div>
    <div class="score-card"><div class="value">{{ issue_counts.high.issues }}</div><div class="label">High priority</div></div>
    <div class="score-card"><div class="value">{{ issue_counts.medium.issues }}</div><div class="label">Medium priority</div></div>
    <div class="score-card"><div class="value">{{ issue_counts.opportunities.issues }}</div><div class="label">Opportunities</div></div>
  </div>
  <p class="muted">
    Affecting {{ issue_counts.critical.pages }}, {{ issue_counts.high.pages }},
    {{ issue_counts.medium.pages }} and {{ issue_counts.opportunities.pages }} pages respectively.
    One issue across seventy pages and seventy issues on one page each look identical without
    both numbers.
  </p>

  {% if blockers %}
  <h2>Top {{ blockers|length }} thing{{ 's' if blockers|length != 1 else '' }} blocking growth</h2>
  <p class="muted">
    Ordered by how much score each is costing right now — drawn from the rule findings and from
    the AEO/GEO signals no rule watches. The growth plan below is ordered differently, by
    leverage, so it starts with the cheapest useful fix.
  </p>
  <table>
    <thead><tr><th>#</th><th>Blocker</th><th>Worth</th><th>Effort</th></tr></thead>
    <tbody>
      {% for blocker in blockers %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <strong>{{ blocker.title }}</strong><br>
          <span class="muted">{{ blocker.detail }}</span><br>
          <strong>Do:</strong> {{ blocker.what_to_do }}
        </td>
        <td>{{ "%.1f"|format(blocker.points_recoverable) }} pts</td>
        <td>{{ blocker.effort_label }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>SEO breakdown</h2>
  <div class="score-grid">
    <div class="score-card"><div class="value">{{ audit.technical_score }}</div><div class="label">Technical &middot; 25%</div></div>
    <div class="score-card"><div class="value">{{ audit.onpage_score }}</div><div class="label">On-page &middot; 20%</div></div>
    <div class="score-card"><div class="value">{{ audit.content_score }}</div><div class="label">Content &middot; 20%</div></div>
    <div class="score-card"><div class="value">{{ audit.internal_links_score }}</div><div class="label">Internal links &middot; 10%</div></div>
    <div class="score-card"><div class="value">{{ audit.structured_data_score }}</div><div class="label">Structured data &middot; 10%</div></div>
    <div class="score-card"><div class="value">{{ audit.performance_score }}</div><div class="label">Performance &middot; 10%</div></div>
    <div class="score-card"><div class="value">{{ audit.authority_score if audit.authority_score is not none else "N/A" }}</div><div class="label">Authority &middot; 5%</div></div>
    <div class="score-card"><div class="value">{{ audit.acrs_score if audit.acrs_score is not none else "N/A" }}</div><div class="label">ACRS (reported separately)</div></div>
  </div>
  {% if audit.authority_score is none %}
  <p class="muted">Authority is reported as not measured, not as zero: Spy's backlink index is
  built from its own crawls and has nothing for this domain yet. Its weight is redistributed
  across the other six components rather than counted as a failure.</p>
  {% endif %}

  {% if evidence.get('aeo', {}).get('components') %}
  <h2>AEO breakdown</h2>
  <table>
    <thead><tr><th>Signal</th><th>Score</th></tr></thead>
    <tbody>
      {% for name, value in evidence['aeo']['components'].items() %}
      <tr><td>{{ name.replace('_', ' ')|title }}</td><td>{{ value if value is not none else "Not measured" }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if evidence.get('geo', {}).get('components') %}
  <h2>GEO breakdown</h2>
  <table>
    <thead><tr><th>Dimension</th><th>Score</th></tr></thead>
    <tbody>
      {% for name, value in evidence['geo']['components'].items() %}
      <tr><td>{{ name.replace('_', ' ')|title }}</td><td>{{ value if value is not none else "Not measured" }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% set unmeasured = (evidence.get('geo', {}).get('not_measured') or []) + (evidence.get('aeo', {}).get('not_measured') or []) %}
  {% if unmeasured %}
  <h2>What was not measured</h2>
  <ul>
    {% for reason in unmeasured %}<li>{{ reason }}</li>{% endfor %}
  </ul>
  {% endif %}

  <h2>All issues ({{ issues|length }})</h2>
  <table>
    <thead><tr><th>Severity</th><th>Issue</th><th>Category</th><th>Affected</th></tr></thead>
    <tbody>
    {% for issue in issues %}
      <tr>
        <td><span class="sev sev-{{ issue.severity }}">{{ issue.severity }}</span></td>
        <td><strong>{{ issue.title }}</strong><br><span class="muted">{{ issue.description }}</span></td>
        <td>{{ issue.category }}</td>
        <td>{{ issue.affected_count }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>90-Day Growth Plan — Prioritized Recommendations</h2>
  <table>
    <thead><tr><th>Priority</th><th>Recommendation</th><th>When</th></tr></thead>
    <tbody>
    {% for rec in recommendations %}
      <tr>
        <td>{{ rec.priority_score }}</td>
        <td><strong>{{ rec.title }}</strong><br><span class="muted">{{ rec.description }}</span></td>
        <td>{{ rec.group }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <div class="footer">
    Generated by Spy &middot; Data sources: Spy Crawler (crawl evidence), deterministic rule engine (score_version {{ audit.score_version }}).
    This report reflects observed data at crawl time, not a guarantee of search ranking or AI-answer-engine placement.
  </div>
</div>
</body>
</html>
